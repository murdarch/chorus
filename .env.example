# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Azure Bot Service - Nous Bot
# Create a Bot Channels Registration in Azure Portal
NOUS_BOT_APP_ID=your_nous_bot_azure_app_id
NOUS_BOT_APP_PASSWORD=your_nous_bot_azure_password

# Azure Bot Service - Claude Bot
# Create a second Bot Channels Registration in Azure Portal
CLAUDE_BOT_APP_ID=your_claude_bot_azure_app_id
CLAUDE_BOT_APP_PASSWORD=your_claude_bot_azure_password

# Server Configuration
PORT=3978
HOST=0.0.0.0

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
